# Place real values in Replit Secrets, never in source control.
DATABASE_URL=<postgresql-connection-string>
SESSION_SECRET=<different-random-secret-of-at-least-32-characters>
# Encryption is derived automatically from the existing SESSION_SECRET.
# Legacy installations only: keep their original valid PILAH_DATA_ENCRYPTION_KEY.

# Only one runtime should connect. Defaults to development; production is locked.
# Before production pairing, stop and disconnect development.
PILAH_LIVE_RUNTIME=development

# Used for a manual API run outside Replit's managed workflows:
PORT=8080
# Frontend manual run additionally needs BASE_PATH=/ and a separate PORT.